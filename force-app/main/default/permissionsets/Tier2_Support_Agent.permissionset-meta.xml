<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Tier 2 Support Agent</label>
    <description>Grants Tier 2 support agents broader case visibility than Tier 1, including escalated cases across accounts, while still withholding org-wide modify-all access reserved for admins.</description>

    <objectPermissions>
        <object>Case</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <field>Case.Support_Tier__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Deflected_By_KB__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.First_Response_At__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <userPermissions>
        <name>KnowledgeSidebar</name>
        <enabled>true</enabled>
    </userPermissions>
    <userPermissions>
        <name>TransferAnyCase</name>
        <enabled>true</enabled>
    </userPermissions>
</PermissionSet>
